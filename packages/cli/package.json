{
  "name": "@discord-fleet-manager/cli",
  "version": "0.0.1",
  "description": "CLI for Discord Fleet Manager",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "phantom-fleet": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@discord-fleet-manager/sdk": "file:../sdk",
    "@discord-fleet-manager/shared": "file:../shared",
    "commander": "^11.1.0",
    "inquirer": "^9.2.12",
    "ora": "^7.0.1",
    "chalk": "^5.3.0",
    "table": "^6.8.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}