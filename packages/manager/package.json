{
  "name": "@discord-fleet-manager/manager",
  "version": "0.0.1",
  "description": "Core fleet manager — Express + WebSocket API, bot runner, Discord monitor, engines, intelligence",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --workspace=unit",
    "test:integration": "vitest run --workspace=integration",
    "db:init": "tsx src/database/init.ts",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@discord-fleet-manager/shared": "file:../shared",
    "@discord-fleet-manager/sdk": "file:../sdk",
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "discord.js": "^14.14.1",
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "tsc-alias": "^1.8.8",
    "tsx": "^4.6.2",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}